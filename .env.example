# UniPath environment variables.
#
# Supabase is OPTIONAL. Leave these blank and the app runs fully in anonymous
# mode (shortlist, profile, cost scenarios, and applications all persist to the
# browser's localStorage). Fill them in to enable optional accounts that sync a
# user's data across devices.
#
# 1. Create a project at https://supabase.com
# 2. Run the migration in supabase/migrations/0001_init.sql (SQL editor or CLI)
# 3. In Auth > URL Configuration, add <your-site-url>/auth/callback as a redirect URL
# 4. Copy the Project URL and the anon/publishable key below into .env.local
#
# Only the anon (publishable) key belongs here — never the service_role key.
# Row Level Security is the security boundary, so the anon key is safe in the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (Google AI Studio) is OPTIONAL. Leave blank and the quiz results page
# shows heuristic matches only, with no AI insight panel — no network calls,
# no errors. Fill it in to enable AI-generated narrative explanations layered
# on top of the existing heuristic match scoring.
#
# Get a key at https://aistudio.google.com/apikey
# Server-only — never prefix with NEXT_PUBLIC_, never expose to the browser.

GEMINI_API_KEY=

# Web3Forms powers the Contact page. OPTIONAL — leave blank and the form falls
# back to a mailto: link instead of submitting directly.
#
# Get a free access key at https://web3forms.com (no account needed — enter the
# email you want submissions delivered to, and the key is emailed to you).
# Client-side by design — this is a public form identifier, not a secret, so it
# must be prefixed with NEXT_PUBLIC_.

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
