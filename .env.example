# UniPath environment variables.
#
# Supabase is REQUIRED. UniPath is a paid product: every route except the
# marketing/legal pages and /payment is gated behind sign-in + an
# admin-approved payment (see src/components/auth/AccessGate.tsx). Leaving
# these blank does NOT fall back to a free anonymous mode — it just leaves the
# paywall gate disabled (dev-only escape hatch), so always set these in any
# environment real users can reach.
#
# 1. Create a project at https://supabase.com
# 2. Run every migration in supabase/migrations/ in order (SQL editor or CLI)
# 3. In Auth > URL Configuration, add <your-site-url>/auth/** as a redirect URL
#    (wildcard covers /auth/callback and /auth/reset-password — the app also
#    forwards a password-recovery session to /auth/reset-password itself if
#    Supabase ever redirects somewhere else, but the allowlist entry above is
#    still required for the recovery code in the emailed link to be honored)
# 4. In Auth > Email Templates > "Reset Password", change the link's href from
#    {{ .ConfirmationURL }} to:
#      {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next={{ .RedirectTo }}
#    Required — Supabase's default {{ .ConfirmationURL }} points straight at
#    its own /verify endpoint, which consumes the one-time code on ANY GET
#    request. Email security scanners (Gmail, Outlook Safe Links, corporate
#    proxies) prefetch links before a human clicks, silently burning the code
#    and making the link show "invalid or has expired" for the real user.
#    /auth/confirm (src/app/auth/confirm/page.tsx) only verifies once real
#    browser JS runs, which a prefetch can't trigger.
# 5. Copy the Project URL and the anon/publishable key below into .env.local
#
# Only the anon (publishable) key belongs here — never the service_role key.
# Row Level Security is the security boundary, so the anon key is safe in the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (Google AI Studio) is OPTIONAL. Leave blank and the quiz results page
# shows heuristic matches only, with no AI insight panel — no network calls,
# no errors. Fill it in to enable AI-generated narrative explanations layered
# on top of the existing heuristic match scoring.
#
# Get a key at https://aistudio.google.com/apikey
# Server-only — never prefix with NEXT_PUBLIC_, never expose to the browser.

GEMINI_API_KEY=

# Web3Forms powers the Contact page. OPTIONAL — leave blank and the form falls
# back to a mailto: link instead of submitting directly.
#
# Get a free access key at https://web3forms.com (no account needed — enter the
# email you want submissions delivered to, and the key is emailed to you).
# Client-side by design — this is a public form identifier, not a secret, so it
# must be prefixed with NEXT_PUBLIC_.

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
